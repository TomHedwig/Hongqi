\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hongqi-marks}[2026/09/02 v0.1 Hongqi running marks]

\newcounter{hongqifirstissuepage}
\newcounter{hongqifirstserialpage}

\newcommand\HongqiStartMainMatter[2]{%
  \clearpage
  \setcounter{page}{#1}%
  \setcounter{hongqifirstissuepage}{#1}%
  \setcounter{hongqifirstserialpage}{#2}%
  \pagestyle{hongqi}%
}

\newcommand\HongqiCurrentSerialPage{%
  \number\numexpr\value{hongqifirstserialpage}+\value{page}-\value{hongqifirstissuepage}\relax
}

\fancypagestyle{hongqi}{%
  \fancyhf{}%
  \renewcommand\headrulewidth{0pt}%
  \renewcommand\footrulewidth{0.4pt}%
  \fancyfoot[LE]{\hongqisong\bfseries\fontsize{8.5pt}{10pt}\selectfont
    ·\thepage·（总\HongqiCurrentSerialPage）}%
  \fancyfoot[RE]{\hongqisong\bfseries\fontsize{8.5pt}{10pt}\selectfont 红旗杂志}%
  \fancyfoot[LO]{\hongqisong\bfseries\fontsize{8.5pt}{10pt}\selectfont
    \HongqiYear 年第\HongqiIssueNumber 期}%
  \fancyfoot[RO]{\hongqisong\bfseries\fontsize{8.5pt}{10pt}\selectfont
    （总\HongqiCurrentSerialPage）·\thepage·}%
}

