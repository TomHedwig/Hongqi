\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hongqi-headings}[2026/09/02 v0.1 Hongqi headings]

\RequirePackage{xparse}
\RequirePackage{expl3}

\ExplSyntaxOn
\tl_new:N \l_hongqi_article_title_tl
\tl_new:N \l_hongqi_article_author_tl
\tl_new:N \l_hongqi_article_kicker_tl
\tl_new:N \l_hongqi_article_style_tl
\tl_new:N \l_hongqi_kicker_font_tl
\tl_new:N \l_hongqi_kicker_align_tl
\dim_new:N \l_hongqi_kicker_size_dim
\dim_new:N \l_hongqi_kicker_leading_dim
\dim_new:N \l_hongqi_kicker_width_dim
\dim_new:N \l_hongqi_kicker_padding_dim
\dim_new:N \l_hongqi_kicker_rule_dim
\dim_new:N \l_hongqi_kicker_after_dim
\fp_new:N \l_hongqi_kicker_line_spacing_fp
\bool_new:N \l_hongqi_kicker_fixed_leading_bool
\dim_new:N \l_hongqi_body_size_dim
\dim_new:N \l_hongqi_body_leading_dim
\tl_new:N \l_hongqi_body_indent_tl
\fp_new:N \l_hongqi_body_line_spacing_fp
\bool_new:N \l_hongqi_body_fixed_leading_bool

\cs_new_protected:Npn \hongqi_set_kicker_size:n #1
{
  \str_case:nnF {#1}
  {
    {chuhao}   { \dim_set:Nn \l_hongqi_kicker_size_dim {42pt} }
      {xiaochu}  { \dim_set:Nn \l_hongqi_kicker_size_dim {36pt} }
      {yihao}    { \dim_set:Nn \l_hongqi_kicker_size_dim {26pt} }
      {xiaoyi}   { \dim_set:Nn \l_hongqi_kicker_size_dim {24pt} }
      {erhao}    { \dim_set:Nn \l_hongqi_kicker_size_dim {22pt} }
      {xiaoer}   { \dim_set:Nn \l_hongqi_kicker_size_dim {18pt} }
      {sanhao}   { \dim_set:Nn \l_hongqi_kicker_size_dim {16pt} }
      {xiaosan}  { \dim_set:Nn \l_hongqi_kicker_size_dim {15pt} }
      {sihao}    { \dim_set:Nn \l_hongqi_kicker_size_dim {14pt} }
      {xiaosi}   { \dim_set:Nn \l_hongqi_kicker_size_dim {12pt} }
      {wuhao}    { \dim_set:Nn \l_hongqi_kicker_size_dim {10.5pt} }
      {xiaowu}   { \dim_set:Nn \l_hongqi_kicker_size_dim {9pt} }
      {liuhao}   { \dim_set:Nn \l_hongqi_kicker_size_dim {7.5pt} }
      {xiaoliu}  { \dim_set:Nn \l_hongqi_kicker_size_dim {6.5pt} }
      {qihao}    { \dim_set:Nn \l_hongqi_kicker_size_dim {5.5pt} }
      {bahao}    { \dim_set:Nn \l_hongqi_kicker_size_dim {5pt} }
  }
  { \dim_set:Nn \l_hongqi_kicker_size_dim {#1} }
}

\cs_new_protected:Npn \hongqi_set_body_size:n #1
{
  \str_case:nnF {#1}
  {
    {chuhao}   { \dim_set:Nn \l_hongqi_body_size_dim {42pt} }
      {xiaochu}  { \dim_set:Nn \l_hongqi_body_size_dim {36pt} }
      {yihao}    { \dim_set:Nn \l_hongqi_body_size_dim {26pt} }
      {xiaoyi}   { \dim_set:Nn \l_hongqi_body_size_dim {24pt} }
      {erhao}    { \dim_set:Nn \l_hongqi_body_size_dim {22pt} }
      {xiaoer}   { \dim_set:Nn \l_hongqi_body_size_dim {18pt} }
      {sanhao}   { \dim_set:Nn \l_hongqi_body_size_dim {16pt} }
      {xiaosan}  { \dim_set:Nn \l_hongqi_body_size_dim {15pt} }
      {sihao}    { \dim_set:Nn \l_hongqi_body_size_dim {14pt} }
      {xiaosi}   { \dim_set:Nn \l_hongqi_body_size_dim {12pt} }
      {wuhao}    { \dim_set:Nn \l_hongqi_body_size_dim {10.5pt} }
      {xiaowu}   { \dim_set:Nn \l_hongqi_body_size_dim {9pt} }
      {liuhao}   { \dim_set:Nn \l_hongqi_body_size_dim {7.5pt} }
      {xiaoliu}  { \dim_set:Nn \l_hongqi_body_size_dim {6.5pt} }
      {qihao}    { \dim_set:Nn \l_hongqi_body_size_dim {5.5pt} }
