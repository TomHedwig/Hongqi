\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hongqi-layout}[2026/09/02 v0.1 Hongqi page layout]

\geometry{
  paperwidth=188mm,
  paperheight=264mm,
  inner=19mm,
  outer=29mm,
  top=37mm,
  bottom=35mm,
  headheight=0pt,
  headsep=0pt,
  footskip=5mm
}

\raggedbottom
\linespread{1}
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\setlength{\columnsep}{6mm}
\setlength{\emergencystretch}{1em}
\clubpenalty=5000
\widowpenalty=5000
\displaywidowpenalty=5000

\newcommand\HongqiNormalBody{%
  \fontsize{10.5pt}{15.5pt}\selectfont
  \setlength{\parindent}{2em}%
  \setlength{\parskip}{0pt}%
}

\newcommand\HongqiLargeBody{%
  \fontsize{12.5pt}{19pt}\selectfont
  \setlength{\parindent}{2em}%
  \setlength{\parskip}{0pt}%
}

\newcommand\HongqiCompactBody{%
  \fontsize{9pt}{12pt}\selectfont
  \setlength{\parindent}{0pt}%
  \setlength{\parskip}{0pt}%
}

\AtBeginDocument{\HongqiNormalBody}
